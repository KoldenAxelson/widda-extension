{
  "manifest_version": 3,
  "name": "Widda",
  "version": "1.0.1",
  "key": "",
  "description": "Offers the promo codes of YouTube creators you subscribe to at checkout. You click Apply; the creator gets credit.",
  "permissions": [
    "storage",
    "identity",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "https://*.squarespace.com/*",
    "https://*.nordvpn.com/*",
    "https://*.audible.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.squarespace.com/*",
        "https://*.nordvpn.com/*",
        "https://*.audible.com/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Widda",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "oauth2": {
    "client_id": "787902971134-46ulghq8gqsk1c2satbk9tikuhalee63.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "https://www.googleapis.com/auth/youtube.readonly"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
